# GEMINI_API_KEY: Required. Your Gemini API key from https://aistudio.google.com/apikey
# On Vercel: Project → Settings → Environment Variables → add GEMINI_API_KEY (then redeploy).
# Locally: copy this file to .env and fill it in.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides (defaults shown).
# GEMINI_LIVE_MODEL="gemini-3.8-live"
# GEMINI_CHAT_MODEL="gemini-3.8-flash"
# GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
